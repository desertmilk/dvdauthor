#!/bin/bash
#+
# Run GNU autotools stuff preparatory to building from the source tree.
#
# Execute this script with the working directory set to the top of
# the dvdauthor source tree, and it will create the configure scripts
# and other related bits and pieces.
#
# You would think "autoreconf -i" on its own would be enough, but
# unfortunately that assumes that a program using iconv also needs
# gettext as well, which is not true for DVDAuthor. So the autoreconf
# reports an error that config.rpath does not exist, which is why it
# has to be explicitly copied below.
#
# Different distro/package-manager layouts put config.rpath in slightly
# different locations, so we try to locate it instead of hard-coding a single path.
#
# Created by Lawrence D'Oliveiro <ldo@geek-central.gen.nz>.
#-
mkdir -p autotools m4
for d in \
    /usr/share/gettext \
    /usr/local/share/gettext \
    /opt/homebrew/opt/gettext/share/gettext \
    /usr/local/opt/gettext/share/gettext \
    /opt/gettext/share/gettext; do
    if [ -f "$d/config.rpath" ]; then
        cp "$d/config.rpath" autotools/
        break
    fi
done
if [ ! -f autotools/config.rpath ]; then
    echo "error: could not find config.rpath; install gettext" >&2
    exit 1
fi
autoreconf -fi

# Autotools generated scripts must use LF line endings. On Windows checkouts, Git may convert them to CRLF and bash then chokes on command substitutions such as `as_ac_Header=...` in configure. Strip carriage returns in place while preserving the executable bit for scripts like configure.
find . -type f \( \
    -name configure -o \
    -name config.guess -o \
    -name config.sub -o \
    -name depcomp -o \
    -name install-sh -o \
    -name ltmain.sh -o \
    -name 'Makefile.in' -o \
    -name '*.m4' \
\) -exec sh -c 'for f do
    if [ -x "$f" ]; then mode=1; else mode=0; fi
    tr -d "\r" < "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    if [ "$mode" = 1 ]; then chmod +x "$f"; fi
done' sh {} +

